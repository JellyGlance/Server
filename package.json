{
  "name": "jellyglance",
  "version": "1.3.0",
  "private": true,
  "description": "JellyGlance - a modern Jellyfin analytics and media control dashboard by Nerdy-Technician.",
  "keywords": [
    "jellyfin",
    "jellyfin-dashboard",
    "media-server",
    "self-hosted",
    "analytics",
    "playback-statistics",
    "quick-connect",
    "sonarr",
    "radarr",
    "lidarr",
    "bazarr",
    "qbittorrent",
    "docker",
    "postgresql",
    "react"
  ],
  "homepage": "https://jellyglance.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/JellyGlance/Server.git"
  },
  "bugs": {
    "url": "https://github.com/JellyGlance/Server/issues"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @jellyglance/api\" \"npm run dev -w @jellyglance/web\"",
    "dev:web": "npm run dev -w @jellyglance/web",
    "dev:api": "npm run dev -w @jellyglance/api",
    "build": "npm run build -w @jellyglance/web",
    "i18n:check": "node scripts/i18n-sync.mjs --check",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "widgets:check": "node scripts/widget-files.mjs --check",
    "widgets:sync": "node scripts/widget-files.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test -w @jellyglance/api",
    "bundle:budget": "node scripts/check-bundle-budget.cjs",
    "bundle:budget:update": "npm run build && node scripts/check-bundle-budget.cjs --update",
    "start": "npm run start -w @jellyglance/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "overrides": {
    "eslint": "10.13.0",
    "fast-uri": "4.2.2",
    "js-yaml": "5.5.0",
    "qs": "6.16.0",
    "vite@5.4.21": "6.4.3",
    "esbuild@0.21.5": "0.25.12",
    "brace-expansion@1": "1.1.21",
    "engine.io": "6.6.11",
    "brace-expansion@5": "5.0.12",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
