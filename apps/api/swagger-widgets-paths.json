{
  "/api/widgets": {
    "get": {
      "tags": [
        "Widgets"
      ],
      "summary": "Catalog of token-auth widget endpoints",
      "description": "Catalog of compact token-auth widget endpoints. Send the Glance API key as x-api-token.",
      "parameters": [
        {
          "name": "x-api-token",
          "in": "header",
          "type": "string",
          "required": true
        },
        {
          "name": "authorization",
          "in": "header",
          "type": "string",
          "description": "Bearer session token also works"
        }
      ],
      "responses": {
        "200": {
          "description": "Catalog of token-auth widget endpoints"
        },
        "401": {
          "description": "Unauthorized"
        },
        "403": {
          "description": "Forbidden"
        },
        "503": {
          "description": "Unable to load widget"
        }
      }
    }
  },
