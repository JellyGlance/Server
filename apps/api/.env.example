POSTGRES_USER = # your postgres username
POSTGRES_PASSWORD = # your postgres password

POSTGRES_IP = # your postgres IP
POSTGRES_PORT = # your postgres port

JWT_SECRET = # ultra secret word

JS_GEOLITE_ACCOUNT_ID = # optional, your GeoLite account ID to show geolocation info for client IPs
JS_GEOLITE_LICENSE_KEY = # optional, your GeoLite account license key to show geolocation info for client IPs

# Optional: delete raw playback rows older than this many days (0 or unset = keep forever, minimum 30).
# Only days already in the daily rollups are pruned. Overrides the Settings > Health value.
# JS_PLAYBACK_RETENTION_DAYS = 0

# Optional: skip first-run wizard (writes into app_config on startup when incomplete)
# JF_HOST = https://jellyfin.example.com
# JF_API_KEY = your-jellyfin-api-key
# JS_AUTH_MODE = local
# JS_USER = admin
# JS_PASSWORD = choose-a-strong-password
# JS_SKIP_FIRST_RUN = true
# JS_PUBLIC_URL = http://192.168.1.10:3010
# Public JellyGlance URL so Gotify can fetch playback/task card images. If unset, cards are inlined.
